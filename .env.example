# Supabase — new API key model (2025)
# Get these from: Project Settings → API
#
# Publishable key (safe for browser — RLS must be enabled on all tables)
# → in Supabase Dashboard: "Publishable key"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret key (server/functions only — never expose to browser)
# → in Supabase Dashboard: "Secret keys" → "service_role"
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
